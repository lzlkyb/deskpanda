# DeskPanda 代码所有权
#
# 作用：PR 创建时自动把对应文件的 owner 加为 reviewer，让改动被对的人看到。
# 本仓库开启了「Require a pull request before merging + 4 项 CI checks」，
# 但不要求人工 approve（required_approving_review_count = 0，2026-11-20 起），
# 也未开启「Require review from Code Owners」——CODEOWNERS 仅做自动分派提醒，不做硬门槛。
# 架构性改动按协作规范 §7 仍需先出方案确认，靠人自觉而非 GitHub 拦截。
#
# 语法：最后匹配的规则生效；目录以 / 结尾；注释用 #。

# ── 架构 / 发版 / 门禁 / 安全：owner 把关 ──────────────────────────
/CLAUDE.md                          @lzlkyb
/README.md                          @lzlkyb
/CHANGELOG.md                       @lzlkyb
/rust-toolchain.toml                @lzlkyb
/.gitattributes                     @lzlkyb
/.gitignore                         @lzlkyb
/.github/                           @lzlkyb
/.githooks/                         @lzlkyb
/tools/                             @lzlkyb

# 前端构建链与依赖清单
/desktop/package.json               @lzlkyb
/desktop/package-lock.json          @lzlkyb
/desktop/vite.config.ts             @lzlkyb
/desktop/eslint.config.mjs          @lzlkyb
/desktop/scripts/                   @lzlkyb

# 更新架构、Tauri 配置、安全原语
/desktop/src-tauri/Cargo.toml       @lzlkyb
/desktop/src-tauri/Cargo.lock       @lzlkyb
/desktop/src-tauri/build.rs         @lzlkyb
/desktop/src-tauri/tauri.conf.json  @lzlkyb
/desktop/src-tauri/src/security/    @lzlkyb
/desktop/src-tauri/src/commands/update.rs  @lzlkyb
/desktop/src/contexts/UpdateContext.tsx    @lzlkyb
/desktop/src/components/update/     @lzlkyb

# ── 远程桌面业务：双方共管 ──────────────────────────────────────
# desktop/src/components/rc/、hooks/、lib/rcPlatform.ts 等业务文件
# 不设 owner，靠 PR 的 4 项 CI 门禁把关，避免单人瓶颈。

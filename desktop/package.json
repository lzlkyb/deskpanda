{
  "name": "deskpanda",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "scripts": {
    "vite:dev": "vite",
    "vite:build": "tsc && vite build",
    "dev:mobile": "vite --config vite.config.mobile.ts",
    "build:mobile": "vite build --config vite.config.mobile.ts",
    "test": "vitest run",
    "motion:check": "node --test scripts/check-motion.mjs",
    "tauri": "tauri",
    "android:apk": "node scripts/android-build.mjs --install",
    "android:apk:build": "node scripts/android-build.mjs",
    "android:apk:release": "node scripts/android-build.mjs --release --install",
    "android:apk:release:build": "node scripts/android-build.mjs --release",
    "android:dev": "node scripts/android-build.mjs --dev",
    "publish:apk": "node scripts/publish-apk.mjs",
    "predev": "node scripts/sync-version.mjs && node scripts/gen-changelog.mjs",
    "dev": "tauri dev",
    "prebuild": "node scripts/sync-version.mjs && node scripts/gen-changelog.mjs",
    "build": "tauri build",
    "updater:generate": "node scripts/generate-updater-json.mjs",
    "release": "node scripts/release.mjs",
    "lint": "eslint .",
    "lint:prune": "eslint . --prune-suppressions"
  },
  "dependencies": {
    "@floating-ui/react": "^0.27.20",
    "@formkit/auto-animate": "^0.10.0",
    "@radix-ui/react-dialog": "^1.3.1",
    "@tanstack/react-query": "^5.60.0",
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-dialog": "^2.4.2",
    "@tauri-apps/plugin-opener": "2.5.4",
    "@tauri-apps/plugin-process": "2.3.1",
    "@tauri-apps/plugin-updater": "2.10.1",
    "framer-motion": "^12.43.0",
    "jsqr": "^1.4.0",
    "lucide-react": "^1.76.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tailwindcss/vite": "^4.0.0",
    "@tauri-apps/cli": "2.11.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "jsdom": "^30.1.3",
    "playwright": "^1.49.0",
    "tailwindcss": "^4.0.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^6.0.0",
    "vitest": "^4.1.10"
  }
}
